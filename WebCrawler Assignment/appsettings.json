{
  "Crawler": {
    "MaxPages": 250,
    "MaxPagesCompanyCheck": 50,
    "MaxRequestRetries": 10,
    "PageLoadTimeOut": "00:00:30",
    "SessionTimeout": "00:15:00",
    "MaxChromeSessions": 5,
    "MaxFirefoxSessions": 15,
    "MaxEdgeSessions": 5,
    "HubUrl": "http://localhost:4444/wd/hub",
    "UserAgent": "CoppermineCrawler/1.0"
  },
  "Requests": {
    "RequestDelay": "00:00:00.500",
    "RequestDelayOffset": "00:00:00.750",
    "ScrollDelay": "00:00:00.500",
    "RequestTimeOut": "00:00:20",
    "MaxScrolls": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
